# ============================================
# Google Cloud / Vertex AI Configuration
# ============================================
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-pro-latest
GOOGLE_APPLICATION_CREDENTIALS=./vertex/secrets/vertex-ai-credentials.json

# Token Limits (for reference)
VERTEX_AI_MAX_INPUT_TOKENS=1048576
VERTEX_AI_MAX_OUTPUT_TOKENS=65536

# ============================================
# Database Configuration (Supabase)
# ============================================
DATABASE_URL=postgresql://user:password@localhost:5432/translation_platform
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ============================================
# Application Configuration
# ============================================
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# ============================================
# Authentication & Security
# ============================================
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_TIME_MINUTES=1440

# ============================================
# Storage Configuration
# ============================================
STORAGE_PROVIDER=supabase  # Options: supabase, s3, local
S3_BUCKET_NAME=translation-platform-storage
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ============================================
# Email Configuration
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=noreply@translation-platform.com

# ============================================
# Monitoring & Logging
# ============================================
SENTRY_DSN=
LOG_LEVEL=INFO
ENABLE_METRICS=false

# ============================================
# Cost Management
# ============================================
GCP_BUDGET_ALERT_THRESHOLD=500
GCP_BUDGET_CAP=1000
ENABLE_COST_TRACKING=true